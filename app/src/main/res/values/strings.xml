    <!-- Onboarding -->
    <string name="onboarding_languages_title">Which language are you learning?</string>
    <string name="onboarding_languages_body">Cards show a word in this language and ask you to recall its meaning.</string>
    <string name="onboarding_languages_note">Translation works offline once its language packs are downloaded, about 30 MB each. You choose when to use mobile data.</string>
    <string name="onboarding_goal_title">How many new words a day?</string>
    <string name="onboarding_goal_body">Each new word comes back for review, so a small number adds up. Ten is a sustainable start.</string>
    <string name="onboarding_reminder_title">Want a daily reminder?</string>
    <string name="onboarding_reminder_body">Words stick when you review them on time. A reminder comes once a day, only when words are waiting. WordMint works fully without it.</string>
